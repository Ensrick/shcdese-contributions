+    // The fixed trusted leaf adapter contains no logging, callbacks, engine
+    // monitor acquisition or native calls. Public gold/goods getters stay exact:
+    // dictionary view versus physical memory is an intentional existing difference.
+    private sealed class RecruitmentCostStorage : INativeRecruitmentCostStorage
+    {
+        private readonly GameUnitManagerAPI host;
+        internal RecruitmentCostStorage(GameUnitManagerAPI host) { this.host = host; }
+        public int ReadPhysicalGold(int carrier) => host._unitsGoldCostsArray.GetBaseAddress().Pointer[carrier];
+        public NativeRecruitmentGoods ReadPhysicalGoods(int carrier) =>
+            Copy(host._euUnitsGoodTypeCostsArray.GetBaseAddress().Pointer[carrier - 22]);
+        public void WritePhysicalGold(int carrier, int value) =>
+            host._unitsGoldCostsArray.GetBaseAddress().Pointer[carrier] = value;
+        public void WritePhysicalGoods(int carrier, NativeRecruitmentGoods value) =>
+            host._euUnitsGoodTypeCostsArray.GetBaseAddress().Pointer[carrier - 22] = Expand(value);
+        public void SetConfiguredGold(int carrier, int value)
+        {
+            host._unitGoldCostsDict.SetValue((eChimps)carrier, value);
+            host._unitsGoldCostsArray.SetValue(carrier, value);
+        }
+        public void SetConfiguredGoods(int carrier, NativeRecruitmentGoods value)
+        {
+            eChimps chimp = (eChimps)carrier;
+            int index = (chimp - eChimps.CHIMP_TYPE_ARCHER);
+            host._euUnitsGoodTypeCostsArray.SetValue(index, Expand(value));
+        }
+        public void ClearConfiguredOverrides()
+        {
+            host._euUnitsGoodTypeCostsArray.ClearOverrides();
+            host._unitGoldCostsDict.ClearOverrides();
+        }
+        internal static NativeRecruitmentGoods Copy(UnitGoodCosts value) => new NativeRecruitmentGoods(
+            (int)value.cost1, (int)value.cost2, (int)value.cost3, (int)value.cost4);
+        private static UnitGoodCosts Expand(NativeRecruitmentGoods value) => new UnitGoodCosts {
+            cost1 = (eGoods32)value.First, cost2 = (eGoods32)value.Second,
+            cost3 = (eGoods32)value.Third, cost4 = (eGoods32)value.Horse };
     }
 
